{
  "name": "simpleapi",
  "version": "0.0.1",
  "description": "A TypeScript web framework built on Fastify and Zod",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "check": "biome check src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiofilipesilva2001/simpleapi.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fabiofilipesilva2001/simpleapi/issues"
  },
  "homepage": "https://github.com/fabiofilipesilva2001/simpleapi#readme",
  "dependencies": {
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
