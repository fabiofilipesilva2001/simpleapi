{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Node.js / JavaScript
    "module": "NodeNext",
    "target": "ES2022",
    "types": ["node"],

    // Library Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Type Checking
    "strict": true,

    // Module / Build Behavior
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // Misc
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}